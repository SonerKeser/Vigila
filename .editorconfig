root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{ts,tsx,js,json,css,html,md,yml,yaml}]
indent_size = 2

# Windows PowerShell 5.1 Türkçe karakterleri ancak BOM varsa doğru okur.
[*.ps1]
charset = utf-8-bom

[*.cs]
csharp_style_namespace_declarations = file_scoped:warning
csharp_style_var_for_built_in_types = true:suggestion
dotnet_sort_system_directives_first = true
